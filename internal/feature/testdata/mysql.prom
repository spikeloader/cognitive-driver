# Amostra no formato do prometheus/mysqld_exporter (réplica).
# TYPE mysql_up gauge
mysql_up 1
# TYPE mysql_global_status_threads_connected untyped
mysql_global_status_threads_connected 140
# TYPE mysql_global_variables_max_connections gauge
mysql_global_variables_max_connections 151
# TYPE mysql_global_status_threads_running untyped
mysql_global_status_threads_running 9
# TYPE mysql_global_status_slow_queries untyped
mysql_global_status_slow_queries 77
# TYPE mysql_global_status_aborted_connects untyped
mysql_global_status_aborted_connects 12
# TYPE mysql_global_status_innodb_row_lock_waits untyped
mysql_global_status_innodb_row_lock_waits 30
# TYPE mysql_global_status_queries untyped
mysql_global_status_queries 8e6
# TYPE mysql_slave_status_slave_io_running gauge
mysql_slave_status_slave_io_running{channel_name="",connection_name="",master_host="10.0.0.10",master_uuid=""} 1
# TYPE mysql_slave_status_slave_sql_running gauge
mysql_slave_status_slave_sql_running{channel_name="",connection_name="",master_host="10.0.0.10",master_uuid=""} 0
# TYPE mysql_slave_status_seconds_behind_master gauge
mysql_slave_status_seconds_behind_master{channel_name="",connection_name="",master_host="10.0.0.10",master_uuid=""} 42
