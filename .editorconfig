root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.{sh,yaml,yml,js,css,html,md,php}]
indent_style = space
indent_size = 2

[deploy/cron/cron-wrap]
indent_style = space
indent_size = 2
