[Unit]
Description=Cognitive Driver (micro-IA de observabilidade)
Documentation=https://prometheus.io/docs/guides/node-exporter/
After=network-online.target prometheus-node-exporter.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/cognitive-driver -check -config /etc/cognitive-driver/config.yaml
ExecStart=/usr/local/bin/cognitive-driver -config /etc/cognitive-driver/config.yaml
# MICRO_AI_TOKEN=... (arquivo root:root 0600, lido pelo systemd antes de reduzir privilégios)
EnvironmentFile=/etc/cognitive-driver/env
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# Usuário efêmero sem privilégios; estado persistente em /var/lib/cognitive-driver.
DynamicUser=yes
StateDirectory=cognitive-driver
StateDirectoryMode=0700
WorkingDirectory=/var/lib/cognitive-driver

# Limites de recursos.
CPUQuota=25%
MemoryMax=128M
TasksMax=64
LimitNOFILE=4096

# Sandbox: o serviço só precisa de rede (node_exporter e API) e do diretório de estado.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
